# Public browser configuration only. Copy this file to .env.local and add your key.
# Do not use a secret key or service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://kdstmntnrmmasepnwdoi.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Existing table names only — do not create replacements just for the frontend.
# The current project does not expose conventional table names to the anon role.
VITE_SUPABASE_READINGS_TABLE=water_readings
VITE_SUPABASE_ALERTS_TABLE=alerts
VITE_SUPABASE_DEVICES_TABLE=water_devices
# Optional if the readings time field is not created_at.
VITE_SUPABASE_READINGS_TIME_COLUMN=recorded_at
